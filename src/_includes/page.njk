<!DOCTYPE html>
<html lang="{{ t.lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ t.title }}</title>
  <meta name="description" content="{{ t.description }}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="uk" href="{{ site.url }}/">
  <link rel="alternate" hreflang="en" href="{{ site.url }}/en/">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.company }}">
  <meta property="og:locale" content="{% if t.lang == 'uk' %}uk_UA{% else %}en_US{% endif %}">
  <meta property="og:title" content="{{ t.title }}">
  <meta property="og:description" content="{{ t.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/hero.jpg">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#0b1220">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "GeneralContractor",
    "name": "{{ site.company }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}/logo.png",
    "image": "{{ site.url }}/hero.jpg",
    "description": "{{ t.description }}",
    "telephone": "{{ site.phoneLink }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "вул. Ярославів Вал, 33-А, приміщення 4",
      "addressLocality": "Київ",
      "addressCountry": "UA"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "09:00",
      "closes": "18:00"
    },
    "areaServed": { "@type": "City", "name": "Київ" }
  }
  </script>
</head>
<body>

  <header class="site-header" id="siteHeader">
    <a href="{{ home }}" class="logo">
      <img src="/logo.png" alt="{{ site.company }}" class="logo-img">
    </a>

    <nav class="nav" id="mainNav">
      <a href="#about">{{ t.nav.about }}</a>
      <a href="#services">{{ t.nav.services }}</a>
      <a href="#portfolio">{{ t.nav.portfolio }}</a>
      <a href="#partners">{{ t.nav.partners }}</a>
      <a href="#contacts">{{ t.nav.contacts }}</a>
    </nav>

    <div class="header-right">
      <div class="lang-switch">
        <a href="/" class="lang-opt{% if t.lang == 'uk' %} is-active{% endif %}">UK</a>
        <span class="lang-sep">/</span>
        <a href="/en/" class="lang-opt{% if t.lang == 'en' %} is-active{% endif %}">EN</a>
      </div>
      <a href="tel:{{ site.phoneLink }}" class="phone">
        <span class="phone-ico">✆</span> {{ site.phone }}
      </a>
      <button class="burger" id="burger" aria-label="{{ t.nav.services }}" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero" id="top">
    <img class="hero-bg" src="/hero.jpg" alt="{{ site.company }}">
    <div class="hero-overlay"></div>

    <div class="hero-body">
      <div class="hero-inner reveal">
        <div class="hero-tag">{{ t.hero.tag }}</div>
        <h1>{{ t.hero.title | safe }}</h1>
        <p class="hero-lead">{{ t.hero.lead }}</p>
        <div class="hero-actions">
          <a href="#contacts" class="btn btn-solid"><span>{{ t.hero.button }}</span></a>
        </div>
      </div>

      <div class="hero-metrics reveal">
        <div><strong data-count="{{ t.hero.metric1num }}">0</strong><em>+</em><span>{{ t.hero.metric1label }}</span></div>
        <div><strong data-count="{{ t.hero.metric2num }}">0</strong><em>+</em><span>{{ t.hero.metric2label }}</span></div>
      </div>
    </div>
  </section>

  <!-- ===== ПОСЛУГИ ===== -->
  <section class="section services" id="services">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-eyebrow">{{ t.services.eyebrow }}</div>
        <h2 class="section-title">{{ t.services.title }}</h2>
        <p class="section-intro">{{ t.services.intro }}</p>
      </div>

      <div class="gallery">
        {% for s in services.items %}
        <a href="#" class="gcard reveal js-open-modal" data-service="{% if t.lang == 'uk' %}{{ s.name }}{% else %}{{ s.nameEn }}{% endif %}" style="--i:{{ loop.index0 }}">
          <div class="gcard-img" style="background-image:url('{{ s.image }}')"></div>
          <div class="gcard-overlay"></div>
          <div class="gcard-body">
            <span class="gcard-num">{{ s.num }}</span>
            <h3>{% if t.lang == 'uk' %}{{ s.title | safe }}{% else %}{{ s.titleEn | safe }}{% endif %}</h3>
            <span class="gcard-arrow">→</span>
            <span class="gcard-cta">{{ t.services.cta }}</span>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ===== ПЕРЕВАГИ ===== -->
  <section class="section advantages" id="advantages">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-eyebrow">{{ t.advantages.eyebrow }}</div>
        <h2 class="section-title">{{ t.advantages.title }}</h2>
      </div>
      <div class="adv-grid">
        {% for a in advantages.items %}
        <div class="adv-item reveal" style="--i:{{ loop.index0 }}">
          {% if a.num %}<div class="adv-num">{{ a.num }}</div>{% endif %}
          <h4>{% if t.lang == 'uk' %}{{ a.title }}{% else %}{{ a.titleEn }}{% endif %}</h4>
          <p>{% if t.lang == 'uk' %}{{ a.text }}{% else %}{{ a.textEn }}{% endif %}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ===== ПОРТФОЛІО ===== -->
  <section class="section portfolio" id="portfolio">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-eyebrow">{{ t.portfolio.eyebrow }}</div>
        <h2 class="section-title">{{ t.portfolio.title }}</h2>
      </div>

      {% if projects.items.length %}
      <div class="portfolio-grid">
        {% for p in projects.items %}
        <a href="#" class="proj reveal" style="--i:{{ loop.index0 }}">
          {% if p.image %}<div class="proj-img" style="background-image:url('{{ p.image }}')"></div>{% endif %}
          <span>{% if t.lang == 'uk' %}{{ p.title }}{% else %}{{ p.titleEn or p.title }}{% endif %}</span>
        </a>
        {% endfor %}
      </div>
      {% else %}
      <div class="works-notice reveal">
        <div class="works-icon">
          <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="24" r="21" stroke="currentColor" stroke-width="2" opacity=".35"/>
            <path d="M24 13v11l7 5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <p class="works-text">{{ t.portfolio.notice }}</p>
        <a href="#contacts" class="btn btn-outline js-open-modal" data-service="{{ t.portfolio.buttonService }}"><span>{{ t.portfolio.button }}</span></a>
      </div>
      {% endif %}
    </div>
  </section>

  <!-- ===== ПАРТНЕРИ ===== -->
  <section class="section partners" id="partners">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-eyebrow">{{ t.partners.eyebrow }}</div>
        <h2 class="section-title">{{ t.partners.title }}</h2>
        <p class="section-intro">{{ t.partners.intro }}</p>
      </div>
      <div class="partners-grid">
        {% for p in partners.items %}
        <div class="partner reveal" style="--i:{{ loop.index0 }}">
          <img src="{{ p.image }}" alt="{{ p.name }}" loading="lazy">
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ===== ПРО НАС ===== -->
  <section class="section about" id="about">
    <div class="container about-inner">
      <div class="reveal">
        <div class="section-eyebrow">{{ t.about.eyebrow }}</div>
        <h2 class="section-title">{{ t.about.title | safe }}</h2>
        <p>{{ t.about.text1 }}</p>
        <p>{{ t.about.text2 }}</p>
      </div>
      <div class="about-stats reveal">
        <div><strong>{{ t.about.stat1num }}</strong><span>{{ t.about.stat1label }}</span></div>
        <div><strong>{{ t.about.stat2num }}</strong><span>{{ t.about.stat2label }}</span></div>
      </div>
    </div>
  </section>

  <!-- ===== КОНТАКТИ ===== -->
  <section class="section contacts" id="contacts">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="container contacts-inner">
      <div class="contacts-info reveal">
        <div class="section-eyebrow">{{ t.contacts.eyebrow }}</div>
        <h2 class="section-title">{{ t.contacts.title | safe }}</h2>
        <p>{{ t.contacts.lead }}</p>
        <ul class="contacts-list">
          <li>
            <span class="ci-label">{{ t.contacts.labelPhone }}</span>
            <a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a>
          </li>
          <li>
            <span class="ci-label">{{ t.contacts.labelEmail }}</span>
            <a href="mailto:{{ site.email }}">{{ site.email }}</a>
          </li>
          <li>
            <span class="ci-label">{{ t.contacts.labelAddress }}</span>
            <span>{% if t.lang == 'uk' %}{{ site.address }}{% else %}{{ site.addressEn }}{% endif %}</span>
          </li>
          <li>
            <span class="ci-label">{{ t.contacts.labelHours }}</span>
            <span>{% if t.lang == 'uk' %}{{ site.hours }}{% else %}{{ site.hoursEn }}{% endif %}</span>
          </li>
        </ul>
      </div>

      <form class="contacts-form reveal" id="mainForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="contact">
        <input type="hidden" name="service" value="{{ t.contacts.formService }}">
        <p class="hidden-field"><label>Не заповнюйте: <input name="bot-field"></label></p>
        <div class="form-glow"></div>
        <div class="form-inner">
          <h3 class="form-title">{{ t.contacts.formTitle }}</h3>
          <p class="form-sub">{{ t.contacts.formSub }}</p>
          <label>
            <input type="text" name="name" required placeholder=" ">
            <span class="lbl">{{ t.contacts.fieldName }}</span>
          </label>
          <label>
            <input type="tel" name="phone" required placeholder=" ">
            <span class="lbl">{{ t.contacts.fieldPhone }}</span>
          </label>
          <label>
            <input type="email" name="email" placeholder=" ">
            <span class="lbl">{{ t.contacts.fieldEmail }}</span>
          </label>
          <label>
            <textarea name="comment" rows="3" placeholder=" "></textarea>
            <span class="lbl">{{ t.contacts.fieldComment }}</span>
          </label>
          <button type="submit" class="btn btn-solid btn-full"><span>{{ t.contacts.submit }}</span></button>
          <p class="form-note">{{ t.contacts.note }}</p>
        </div>
      </form>
    </div>
  </section>

  <!-- ===== ФУТЕР ===== -->
  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <img src="/logo.png" alt="{{ site.company }}" class="logo-img logo-img-footer">
        <p>{{ t.footer.rights }}</p>
      </div>
      <nav class="footer-nav">
        <a href="#services">{{ t.nav.services }}</a>
        <a href="#portfolio">{{ t.nav.portfolio }}</a>
        <a href="#partners">{{ t.nav.partners }}</a>
        <a href="#about">{{ t.nav.about }}</a>
        <a href="#contacts">{{ t.nav.contacts }}</a>
      </nav>
      {% if site.facebook or site.instagram %}
      <div class="footer-social">
        {% if site.facebook %}<a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>{% endif %}
        {% if site.instagram %}<a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>{% endif %}
      </div>
      {% endif %}
    </div>
  </footer>

  <!-- ===== МОДАЛЬНЕ ВІКНО ===== -->
  <div class="modal" id="modal" aria-hidden="true">
    <div class="modal-backdrop js-close-modal"></div>
    <div class="modal-window" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-glow"></div>
      <div class="modal-inner">
        <button class="modal-close js-close-modal" aria-label="{{ t.modal.close }}">&times;</button>
        <div class="modal-eyebrow" id="modalService">{{ t.modal.eyebrow }}</div>
        <h3 class="modal-title" id="modalTitle">{{ t.modal.title }}</h3>
        <p class="modal-sub">{{ t.modal.sub }}</p>

        <form class="modal-form" id="leadForm" name="lead" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="lead">
          <p class="hidden-field"><label>Не заповнюйте: <input name="bot-field"></label></p>
          <input type="hidden" name="service" id="fieldService" value="">
          <label>
            <input type="text" name="name" required placeholder=" ">
            <span class="lbl">{{ t.contacts.fieldName }}</span>
          </label>
          <label>
            <input type="tel" name="phone" required placeholder=" ">
            <span class="lbl">{{ t.contacts.fieldPhone }}</span>
          </label>
          <label>
            <textarea name="comment" rows="3" placeholder=" "></textarea>
            <span class="lbl">{{ t.modal.fieldComment }}</span>
          </label>
          <button type="submit" class="btn btn-solid btn-full"><span>{{ t.contacts.submit }}</span></button>
          <p class="form-note">{{ t.contacts.note }}</p>
        </form>

        <div class="modal-success" id="modalSuccess">
          <div class="success-icon">
            <svg viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="26" cy="26" r="24" stroke="currentColor" stroke-width="2.5"/>
              <path d="M15 27l8 8 15-16" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h4>{{ t.modal.successTitle }}</h4>
          <p>{{ t.modal.successText }}</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    window.TELEGRAM_BOT_TOKEN = "{{ site.telegramToken }}";
    window.TELEGRAM_CHAT_IDS = {{ site.telegramChats | dump | safe }};
  </script>
  <script src="/script.js"></script>
</body>
</html>
